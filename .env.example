# Dar Zafran — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=production
# Set APP_DEBUG=true only in local development
APP_DEBUG=false
# Full URL to the project root (no trailing slash)
APP_URL=http://localhost/Moroccan%20luxury%20restaurant%20template

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dar_zafran
DB_USER=root
DB_PASSWORD=

# ─── CORS ────────────────────────────────────────────────────────────────────
# In production: set this to your domain (e.g. https://www.darzafran.ma)
# In development: matches APP_URL
CORS_ORIGIN=http://localhost/Moroccan%20luxury%20restaurant%20template

# ─── First-run Admin Seeder ───────────────────────────────────────────────────
# Used ONLY by: php api/database/seed.php
# Set these before running the seeder for the first time.
# ADMIN_PASSWORD is optional: if empty, a random password is generated and
# printed once to the terminal — it is never stored in source control.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
